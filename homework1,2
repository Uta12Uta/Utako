    # Example: Find the most linked pages.
    def find_most_linked_pages(self):
        link_count = {}
        for id in self.titles.keys():
            link_count[id] = 0

        for id in self.titles.keys():
            for dst in self.links[id]:
                link_count[dst] += 1

        print("The most linked pages are:")
        link_count_max = max(link_count.values())
        for dst in link_count.keys():
            if link_count[dst] == link_count_max:
                print(self.titles[dst], link_count_max)
        print()




    # Homework #1: Find the shortest path.
    # 'start': A title of the start page.
    # 'goal': A title of the goal page.
    def find_shortest_path(self, start, goal):
      start_id = [k for k, v in self.titles.items() if v == start][0] #idで追う
      goal_id = [k for k, v in self.titles.items() if v == goal][0]
      queue = Queue()
      visited = {}
      parent = {}
      visited[start_id] = True
      queue.enqueue(start_id)

      while not queue.empty():
          node = queue.dequeue()
          if node == goal_id:
            path = [goal_id]
            while path[-1] != start_id: #startになるまでさかのぼる
              path.append(parent[path[-1]])
            path.reverse()
            print("The shortest path are:")
            for path_id in path:
              path_title = self.titles[path_id]
              print(path_title)

          for child in self.links[node]:
              if not child in visited:
                  visited[child] = True
                  queue.enqueue(child)
                  parent[child] = node

      return "Not found"



